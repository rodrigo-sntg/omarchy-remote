# Maintainer: Rodrigo Santiago <rodrigosantsilva@gmail.com>
pkgname=omarchy-remote-git
_pkgname=omarchy-remote
pkgver=r0
pkgrel=1
pkgdesc="Your Android phone as Omarchy's remote: trackpad, keyboard, screen, coding agents and control center, over Tailscale"
arch=('any')
url="https://github.com/rodrigo-sntg/omarchy-remote"
license=('MIT')
depends=('python' 'python-aiohttp' 'python-evdev' 'python-cryptography' 'tailscale' 'hyprland' 'grim' 'wf-recorder' 'wl-clipboard'
         'playerctl' 'qrencode' 'wireplumber' 'iproute2' 'xdg-user-dirs')
makedepends=('git')
optdepends=(
    'herdr: your Claude Code and Codex agents on the phone'
    'networkmanager: waking the PC from the phone (Wake-on-LAN)'
    'slurp: screenshot of an area to the phone'
    'zenity: picking files to send to the phone'
)
provides=("${_pkgname}")
conflicts=("${_pkgname}")
install="${_pkgname}.install"
source=("${_pkgname}::git+${url}.git")
sha256sums=('SKIP')

pkgver() {
    cd "$srcdir/${_pkgname}"
    printf "r%s.%s" "$(git rev-list --count HEAD)" "$(git rev-parse --short=7 HEAD)"
}

package() {
    cd "$srcdir/${_pkgname}"
    # The PC service (Python) and its entry points
    install -d "$pkgdir/usr/lib/${_pkgname}"
    cp -r host/keypad_host "$pkgdir/usr/lib/${_pkgname}/"
    find "$pkgdir/usr/lib/${_pkgname}" -name __pycache__ -prune -exec rm -rf {} +
    install -Dm755 packaging/aur/omarchy-remote-host "$pkgdir/usr/bin/omarchy-remote-host"
    install -Dm755 host/omarchy-remote        "$pkgdir/usr/bin/omarchy-remote"
    install -Dm755 host/omarchy-remote-setup  "$pkgdir/usr/bin/omarchy-remote-setup"
    install -Dm755 host/omarchy-remote-remove "$pkgdir/usr/bin/omarchy-remote-remove"
    # Fingerprint unlock (off until the person runs: sudo omarchy-remote-unlock-setup)
    install -Dm755 host/omarchy-remote-unlock-setup "$pkgdir/usr/bin/omarchy-remote-unlock-setup"
    install -Dm755 host/pam-unlock-code "$pkgdir/usr/lib/${_pkgname}/pam-unlock-code"
    install -Dm644 packaging/aur/omarchy-remote-host.service "$pkgdir/usr/lib/systemd/user/omarchy-remote-host.service"
    # The virtual keyboard and mouse: uinput for the logged-in user
    install -Dm644 packaging/aur/60-omarchy-remote.rules "$pkgdir/usr/lib/udev/rules.d/60-omarchy-remote.rules"
    install -Dm644 packaging/aur/omarchy-remote.modules-load.conf "$pkgdir/usr/lib/modules-load.d/${_pkgname}.conf"
    # Omarchy integration (Phone menu, bar icon, theme hook), applied per user by omarchy-remote-setup
    install -d "$pkgdir/usr/share/${_pkgname}/omarchy/plugin"
    install -m644 omarchy/menu.jsonc omarchy/menu_merge.py "$pkgdir/usr/share/${_pkgname}/omarchy/"
    install -m755 omarchy/install.sh omarchy/theme-set "$pkgdir/usr/share/${_pkgname}/omarchy/"
    install -m644 omarchy/plugin/* "$pkgdir/usr/share/${_pkgname}/omarchy/plugin/"
    install -Dm644 LICENSE   "$pkgdir/usr/share/licenses/${_pkgname}/LICENSE"
    install -Dm644 README.md "$pkgdir/usr/share/doc/${_pkgname}/README.md"
}
