#!/usr/bin/python3
"""PAM check for Omarchy Remote (pam_exec expose_authtok): succeeds only when what was typed on the
lock screen is the one-time code the Omarchy Remote service just made after the phone's fingerprint.
The code lives in /run/user/<uid>/omarchy-remote/unlock-code (only that user reads it), lasts 60 s
and works once. Anything else (the real password included) fails here and goes on to pam_unix."""
import hmac
import os
import pwd
import stat
import sys
import time


def main() -> int:
    typed = sys.stdin.buffer.read(4096).split(b"\0")[0].decode(errors="replace").strip()
    user = os.environ.get("PAM_USER", "")
    try:
        uid = pwd.getpwnam(user).pw_uid
    except KeyError:
        return 1
    # Only the arguments on the /etc/pam.d line (root's) may change these; never the environment.
    args = dict(zip(sys.argv[1::2], sys.argv[2::2]))
    folder = args.get("--dir") or f"/run/user/{uid}/omarchy-remote"
    path = os.path.join(folder, "unlock-code")
    try:
        st = os.lstat(path)
        if not stat.S_ISREG(st.st_mode) or st.st_uid != uid or st.st_mode & 0o077:
            return 1
        with open(path) as f:
            code, expires = f.read().split()
    except (OSError, ValueError):
        return 1
    now = float(args.get("--now") or time.time())
    if len(typed) != 32 or now > float(expires) or not hmac.compare_digest(typed, code):
        return 1
    try:
        os.unlink(path)   # once
    except OSError:
        return 1
    return 0


if __name__ == "__main__":
    sys.exit(main())
