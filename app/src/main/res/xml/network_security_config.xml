<?xml version="1.0" encoding="utf-8"?>
<!--
  Cleartext WebSocket only to Tailscale MagicDNS names: that traffic travels inside the
  tailnet's WireGuard tunnel. Every other destination keeps the platform default (TLS only).
-->
<network-security-config>
    <base-config cleartextTrafficPermitted="false" />
    <domain-config cleartextTrafficPermitted="true">
        <domain includeSubdomains="true">ts.net</domain>
    </domain-config>
</network-security-config>
